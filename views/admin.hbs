<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>管理后台 — SNG SmartOJ</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Noto+Sans+SC:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    :root {
      --accent:    hsl(25, 76%, 52%);
      --surface:   hsl(220, 14%, 99%);
      --surface-2: hsl(220, 14%, 95%);
    }
    body { background: var(--bg); color: var(--text); min-height: 100vh; }
    .admin-header { display: flex; align-items: center; gap: 12px; padding: 14px 24px; background: var(--surface); border-bottom: 1px solid var(--border); }
    .admin-header .logo { font-size: 18px; font-weight: 700; color: var(--text); font-family: 'JetBrains Mono', monospace; }
    .admin-header .logo-accent { color: var(--accent); }
    .admin-header-right { margin-left: auto; display: flex; align-items: center; gap: 10px; }
    .admin-title { font-size: 13px; color: var(--text-muted); font-weight: 500; }
    .admin-body { display: flex; height: calc(100vh - 53px); }
    .admin-sidebar { width: 200px; background: var(--surface); border-right: 1px solid var(--border); padding: 16px 0; flex-shrink: 0; }
    .sidebar-item { display: flex; align-items: center; gap: 8px; padding: 9px 20px; font-size: 13px; color: var(--text-muted); cursor: pointer; transition: all 0.15s; border-left: 2px solid transparent; }
    .sidebar-item:hover { color: var(--text); background: var(--surface-2); }
    .sidebar-item.active { color: var(--accent); background: var(--surface-2); border-left-color: var(--accent); }
    .admin-content { flex: 1; overflow-y: auto; padding: 24px; }
    .admin-panel { display: none; }
    .admin-panel.active { display: block; }
    .panel-title { font-size: 15px; font-weight: 600; color: var(--text); margin-bottom: 20px; }

    /* 用户表格 */
    .user-table-wrap { overflow-x: auto; }
    .user-table { width: 100%; border-collapse: collapse; font-size: 13px; }
    .user-table th { text-align: left; padding: 8px 12px; color: var(--text-muted); font-weight: 500; border-bottom: 1px solid var(--border); white-space: nowrap; }
    .user-table td { padding: 9px 12px; border-bottom: 1px solid var(--border); vertical-align: middle; }
    .user-table tr:hover td { background: var(--surface-2); }
    .role-badge { display: inline-block; padding: 2px 8px; border-radius: 4px; font-size: 11px; font-weight: 600; }
    .role-superadmin { background: rgba(234,108,28,0.15); color: hsl(25,76%,43%); }
    .role-admin { background: rgba(37,99,235,0.15); color: #2563eb; }
    .role-palacestudent { background: rgba(34,197,94,0.15); color: #22c55e; }
    .role-user { background: rgba(100,116,139,0.15); color: var(--text-muted); }
    .account-id-mono { font-family: 'JetBrains Mono', monospace; font-size: 12px; color: var(--accent); }
    .btn-sm { padding: 4px 10px; font-size: 12px; border: 1px solid var(--border); border-radius: 4px; background: var(--surface); color: var(--text); cursor: pointer; transition: all 0.15s; }
    .btn-sm:hover { background: var(--surface-2); }
    .btn-sm.danger { border-color: rgba(239,68,68,0.4); color: #ef4444; }
    .btn-sm.primary { border-color: var(--accent); color: var(--accent); background: rgba(234,108,28,0.06); }
    .btn-sm.primary:hover { background: rgba(234,108,28,0.12); }
    .btn-sm.unlock-btn { border-color: rgba(34,197,94,0.4); color: #16a34a; background: rgba(34,197,94,0.06); }
    .btn-sm.unlock-btn:hover { background: rgba(34,197,94,0.12); }
    .btn-sm.disable-btn { border-color: rgba(239,68,68,0.4); color: #ef4444; background: rgba(239,68,68,0.06); }
    .btn-sm.disable-btn:hover { background: rgba(239,68,68,0.12); }
    .btn-sm.enable-btn { border-color: rgba(34,197,94,0.4); color: #16a34a; background: rgba(34,197,94,0.06); }
    .btn-sm.enable-btn:hover { background: rgba(34,197,94,0.12); }
    .btn-sm.export-btn { border-color: rgba(37,99,235,0.4); color: #2563eb; background: rgba(37,99,235,0.06); }
    .btn-sm.export-btn:hover { background: rgba(37,99,235,0.12); }
    .locked-badge { font-size: 11px; color: #ef4444; font-weight: 600; }
    .disabled-badge { font-size: 11px; color: #f97316; font-weight: 600; }
    .row-locked td, .row-disabled td { opacity: 0.65; }
    .row-locked td:last-child, .row-disabled td:last-child { opacity: 1; }

    /* 用户表格工具栏 */
    .user-toolbar { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; flex-wrap: wrap; }
    .user-toolbar .toolbar-right { margin-left: auto; display: flex; gap: 8px; }
    .export-count { font-size: 12px; color: var(--text-muted); }

    /* 复选框样式 */
    .user-checkbox { width: 15px; height: 15px; cursor: pointer; accent-color: var(--accent); }

    /* 编辑模态框 */
    .modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.5); display: none; align-items: center; justify-content: center; z-index: 100; }
    .modal-overlay.open { display: flex; }
    .modal { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; width: 420px; max-width: 95vw; }
    .modal-header { display: flex; align-items: center; justify-content: space-between; padding: 16px 20px; border-bottom: 1px solid var(--border); }
    .modal-header h3 { font-size: 14px; font-weight: 600; }
    .modal-body { padding: 20px; }
    .form-group { margin-bottom: 14px; }
    .form-label { font-size: 12px; color: var(--text-muted); margin-bottom: 5px; display: block; font-weight: 500; }
    .form-input { width: 100%; padding: 8px 11px; background: var(--bg); border: 1px solid var(--border); border-radius: 5px; font-size: 13px; color: var(--text); font-family: inherit; box-sizing: border-box; }
    .form-input:focus { outline: none; border-color: var(--accent); }
    .form-select { width: 100%; padding: 8px 11px; background: var(--bg); border: 1px solid var(--border); border-radius: 5px; font-size: 13px; color: var(--text); font-family: inherit; }
    .modal-footer { display: flex; gap: 8px; justify-content: flex-end; padding: 14px 20px; border-top: 1px solid var(--border); }
    .btn-cancel { padding: 7px 16px; font-size: 13px; border: 1px solid var(--border); border-radius: 5px; background: transparent; color: var(--text-muted); cursor: pointer; }
    .btn-save { padding: 7px 16px; font-size: 13px; background: var(--accent); color: #fff; border: none; border-radius: 5px; cursor: pointer; font-weight: 500; }
    .btn-save:hover { opacity: 0.88; }
    .modal-msg { font-size: 12px; color: #ef4444; margin-top: 10px; display: none; }
    .modal-msg.show { display: block; }

    /* 题目管理 */
    .add-problem-form { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 20px; margin-bottom: 24px; }
    .problem-list { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; overflow: hidden; }
    .problem-row { display: flex; align-items: center; gap: 12px; padding: 10px 16px; border-bottom: 1px solid var(--border); font-size: 13px; }
    .problem-row:last-child { border-bottom: none; }
    .problem-id { font-family: 'JetBrains Mono', monospace; font-size: 12px; color: var(--accent); width: 60px; flex-shrink: 0; }
    .problem-title { flex: 1; }
    .btn-row { display: flex; gap: 8px; margin-top: 16px; }

    /* Prompts */
    .prompts-wrap { display: flex; flex-direction: column; gap: 16px; }
    .prompt-card { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; overflow: hidden; }
    .prompt-card-header { padding: 10px 16px; border-bottom: 1px solid var(--border); font-size: 12px; font-weight: 600; color: var(--text-muted); font-family: 'JetBrains Mono', monospace; }
    .prompt-card textarea { width: 100%; padding: 12px 16px; background: transparent; border: none; font-size: 12px; color: var(--text); font-family: 'JetBrains Mono', monospace; resize: vertical; min-height: 80px; box-sizing: border-box; line-height: 1.6; }
    .prompt-card textarea:focus { outline: none; }
    .section-msg { font-size: 12px; margin: 10px 0; padding: 7px 12px; border-radius: 5px; display: none; }
    .section-msg.success { background: rgba(34,197,94,0.1); color: #22c55e; display: block; }
    .section-msg.error { background: rgba(239,68,68,0.1); color: #ef4444; display: block; }
  </style>
</head>
<body>
  <div class="admin-header">
    <a href="/" style="text-decoration:none">
      <div class="logo">SNG<span class="logo-accent">SmartOJ</span></div>
    </a>
    <span class="admin-title">管理后台</span>
    <div class="admin-header-right">
      <span id="adminUserInfo" style="font-size:12px;color:var(--text-muted)">…</span>
      <a href="/" class="btn-sm">返回主界面</a>
    </div>
  </div>

  <div class="admin-body">
    <!-- 侧边栏 -->
    <div class="admin-sidebar">
      <div class="sidebar-item active" data-panel="users">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
        用户管理
      </div>
      <div class="sidebar-item" data-panel="problems">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
        题库管理
      </div>
      <div class="sidebar-item" data-panel="prompts">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
        提示词
      </div>
      <div class="sidebar-item" data-panel="feedback">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z"/></svg>
        反馈管理
      </div>
      <div class="sidebar-item" data-panel="activetime">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        活跃时长
      </div>
      <div class="sidebar-item" data-panel="graph">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><circle cx="4" cy="6" r="2"/><circle cx="20" cy="6" r="2"/><circle cx="4" cy="18" r="2"/><circle cx="20" cy="18" r="2"/><line x1="6" y1="7" x2="10" y2="10"/><line x1="18" y1="7" x2="14" y2="10"/><line x1="6" y1="17" x2="10" y2="14"/><line x1="18" y1="17" x2="14" y2="14"/></svg>
        问题图谱
      </div>
    </div>

    <!-- 内容区 -->
    <div class="admin-content">

      <!-- 用户管理 -->
      <div class="admin-panel active" id="panel-users">
        <div class="panel-title">用户管理</div>
        <div class="user-toolbar">
          <span class="export-count" id="exportCount">已选 0 人</span>
          <div class="toolbar-right">
            <button class="btn-sm export-btn" id="exportSelectedBtn" disabled>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:middle;margin-right:4px"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              导出选中对话 CSV
            </button>
            <button class="btn-sm export-btn" id="exportAllBtn">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:middle;margin-right:4px"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              导出全部对话 CSV
            </button>
          </div>
        </div>
        <div class="user-table-wrap">
          <table class="user-table" id="userTable">
            <thead>
              <tr>
                <th style="width:32px"><input type="checkbox" class="user-checkbox" id="checkAll" title="全选"></th>
                <th>账号编号</th>
                <th>用户名</th>
                <th>邮箱</th>
                <th>姓名</th>
                <th>学生证</th>
                <th>角色</th>
                <th>注册时间</th>
                <th>API调用次数</th>
                <th>总花费</th>
                <th>状态</th>
                <th>操作</th>
              </tr>
            </thead>
            <tbody id="userTableBody"></tbody>
          </table>
        </div>
      </div>

      <!-- 题库管理 -->
      <div class="admin-panel" id="panel-problems">
        <div class="panel-title">题库管理</div>
        <div class="add-problem-form">
          <div style="font-size:13px;font-weight:600;margin-bottom:14px;">添加新题目（写入全局 problems.json）</div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
            <div class="form-group">
              <label class="form-label">题目编号（必填，需唯一）</label>
              <input type="text" id="newProbId" class="form-input" placeholder="例：1011">
            </div>
            <div class="form-group">
              <label class="form-label">标题（必填）</label>
              <input type="text" id="newProbTitle" class="form-input" placeholder="例：最长公共子序列">
            </div>
          </div>
          <div class="form-group">
            <label class="form-label">题目描述</label>
            <textarea id="newProbDesc" class="form-input" rows="3" style="resize:vertical"></textarea>
          </div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
            <div class="form-group">
              <label class="form-label">输入说明</label>
              <textarea id="newProbInput" class="form-input" rows="2" style="resize:vertical"></textarea>
            </div>
            <div class="form-group">
              <label class="form-label">输出说明</label>
              <textarea id="newProbOutput" class="form-input" rows="2" style="resize:vertical"></textarea>
            </div>
          </div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
            <div class="form-group">
              <label class="form-label">时间限制(ms)</label>
              <input type="number" id="newProbTime" class="form-input" value="1000">
            </div>
            <div class="form-group">
              <label class="form-label">内存限制(MB)</label>
              <input type="number" id="newProbMem" class="form-input" value="128">
            </div>
          </div>
          <div class="section-msg" id="addProbMsg"></div>
          <button class="btn-save" id="addProbBtn">添加题目</button>
        </div>

        <div class="panel-title">现有题目</div>
        <div class="problem-list" id="problemList"></div>
      </div>

      <!-- 提示词管理 -->
      <div class="admin-panel" id="panel-prompts">
        <div class="panel-title">提示词管理（prompts.json）</div>
        <div class="section-msg" id="promptsMsg"></div>
        <div class="prompts-wrap" id="promptsWrap"></div>
        <div class="btn-row">
          <button class="btn-save" id="savePromptsBtn">保存所有提示词</button>
        </div>
      </div>

      <!-- 活跃时长 -->
      <div class="admin-panel" id="panel-activetime">
        <div class="panel-title">活跃对话时长</div>
        <div style="margin-bottom:16px;display:flex;align-items:center;gap:10px">
          <button class="btn-sm export-btn" id="exportActiveTimeBtn">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:middle;margin-right:4px"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            导出汇总表 CSV
          </button>
          <span style="font-size:12px;color:var(--text-muted)">用户看不到此数据。5分钟无交互不计入。</span>
        </div>
        <div class="user-table-wrap">
          <table class="user-table" id="activeTimeTable">
            <thead>
              <tr>
                <th>账号编号</th>
                <th>用户名</th>
                <th>姓名</th>
                <th>活跃天数</th>
                <th>总时长(分钟)</th>
                <th>活跃日均(分钟)</th>
              </tr>
            </thead>
            <tbody id="activeTimeTableBody"></tbody>
          </table>
        </div>
      </div>

      <!-- 反馈管理 -->
      <div class="admin-panel" id="panel-feedback">
        <div class="panel-title">反馈管理</div>
        <div class="section-msg" id="feedbackMsg"></div>
        <div id="feedbackTableWrap" class="user-table-wrap">
          <table class="user-table" id="feedbackTable">
            <thead>
              <tr>
                <th>用户</th>
                <th>反馈内容</th>
                <th>时间</th>
                <th>状态</th>
                <th>操作</th>
              </tr>
            </thead>
            <tbody id="feedbackTableBody"></tbody>
          </table>
        </div>
      </div>

      <!-- 问题图谱管理 -->
      <div class="admin-panel" id="panel-graph">
        <div class="panel-title">问题图谱管理</div>
        <div id="graphInfo" style="font-size:13px;color:var(--text-muted);margin-bottom:16px">加载中…</div>

        <!-- 修改题目难度 -->
        <div style="margin-bottom:24px;padding:16px;border:1px solid var(--border);border-radius:8px;background:var(--surface)">
          <div style="font-size:13px;font-weight:600;margin-bottom:10px">修改题目难度</div>
          <div style="display:flex;gap:8px;align-items:end;flex-wrap:wrap">
            <div class="form-group" style="margin:0;flex:0 0 80px">
              <label class="form-label">题号</label>
              <input type="text" id="graphDiffId" class="form-input" placeholder="1007">
            </div>
            <div class="form-group" style="margin:0;flex:0 0 60px">
              <label class="form-label">难度(1-10)</label>
              <input type="number" id="graphDiffValue" class="form-input" min="1" max="10">
            </div>
            <div class="form-group" style="margin:0;flex:1">
              <label class="form-label">修改理由</label>
              <input type="text" id="graphDiffReason" class="form-input" placeholder="教师评估">
            </div>
            <button class="btn-sm primary" id="graphDiffSubmit">修改</button>
          </div>
          <div class="section-msg" id="graphDiffMsg" style="margin-top:6px"></div>
        </div>

        <!-- 添加关系边 -->
        <div style="margin-bottom:24px;padding:16px;border:1px solid var(--border);border-radius:8px;background:var(--surface)">
          <div style="font-size:13px;font-weight:600;margin-bottom:10px">添加关系边</div>
          <div style="display:flex;gap:8px;align-items:end;flex-wrap:wrap">
            <div class="form-group" style="margin:0;flex:0 0 80px">
              <label class="form-label">题A</label>
              <input type="text" id="graphEdgeA" class="form-input" placeholder="1007">
            </div>
            <div class="form-group" style="margin:0;flex:0 0 80px">
              <label class="form-label">题B</label>
              <input type="text" id="graphEdgeB" class="form-input" placeholder="1008">
            </div>
            <div class="form-group" style="margin:0;flex:0 0 160px">
              <label class="form-label">关系类型</label>
              <select id="graphEdgeType" class="form-input">
                <option value="SIMILAR_TO">SIMILAR_TO（相似）</option>
                <option value="SAME_TECHNIQUE">SAME_TECHNIQUE（同技巧）</option>
                <option value="PREREQUISITE_OF">PREREQUISITE_OF（A是B前置）</option>
                <option value="HARDER_VERSION">HARDER_VERSION（B是A加强版）</option>
              </select>
            </div>
            <div class="form-group" style="margin:0;flex:1">
              <label class="form-label">备注</label>
              <input type="text" id="graphEdgeReason" class="form-input" placeholder="教师标注">
            </div>
            <button class="btn-sm primary" id="graphEdgeSubmit">添加</button>
          </div>
          <div class="section-msg" id="graphEdgeMsg" style="margin-top:6px"></div>
        </div>

        <!-- 现有边列表 -->
        <div style="padding:16px;border:1px solid var(--border);border-radius:8px;background:var(--surface)">
          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px">
            <div style="font-size:13px;font-weight:600">关系边列表</div>
            <button class="btn-sm" id="graphRefreshEdges">刷新</button>
          </div>
          <div class="user-table-wrap" style="max-height:400px;overflow-y:auto">
            <table class="user-table" id="graphEdgesTable">
              <thead>
                <tr>
                  <th>题A</th>
                  <th>题B</th>
                  <th>类型</th>
                  <th>置信度</th>
                  <th>来源</th>
                  <th>理由</th>
                  <th>操作</th>
                </tr>
              </thead>
              <tbody id="graphEdgesTableBody"></tbody>
            </table>
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- 编辑用户模态框 -->
  <div class="modal-overlay" id="editUserModal">
    <div class="modal">
      <div class="modal-header">
        <h3>编辑用户 <span id="editUserId" class="account-id-mono"></span></h3>
        <button class="icon-btn-xs" id="closeEditUser">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <div class="modal-body">
        <div class="form-group">
          <label class="form-label">用户名</label>
          <input type="text" id="editUsername" class="form-input">
        </div>
        <div class="form-group">
          <label class="form-label">邮箱</label>
          <input type="email" id="editEmail" class="form-input">
        </div>
        <div class="form-group">
          <label class="form-label">姓名</label>
          <input type="text" id="editDisplayName" class="form-input">
        </div>
        <div class="form-group">
          <label class="form-label">学生证编号（12位数字）</label>
          <input type="text" id="editStudentId" class="form-input" maxlength="12">
        </div>
        <div class="form-group" id="editRoleGroup">
          <label class="form-label">角色（仅超级管理员可改）</label>
          <select id="editRole" class="form-select">
            <option value="user">普通用户</option>
            <option value="palacestudent">少年宫用户</option>
            <option value="admin">管理员</option>
            <option value="superadmin">超级管理员</option>
          </select>
        </div>
        <hr style="border:none;border-top:1px solid var(--border);margin:16px 0;">
        <div class="form-group">
          <label class="form-label">重置密码（留空不修改）</label>
          <input type="password" id="editNewPassword" class="form-input" placeholder="输入新密码（至少6位）">
        </div>
        <div class="modal-msg" id="editUserMsg"></div>
      </div>
      <div class="modal-footer">
        <button class="btn-cancel" id="cancelEditUser">取消</button>
        <button class="btn-save" id="saveEditUser">保存</button>
      </div>
    </div>
  </div>

  <div id="toast" class="toast"></div>

  <script>
    let currentUser = null;
    let allUsers    = [];
    let editingId   = null;

    // ── 初始化 ──────────────────────────────────────────────
    async function init() {
      const res  = await fetch('/api/auth/me');
      const data = await res.json();
      if (!data.loggedIn) return window.location.href = '/login';
      currentUser = data.user;
      document.getElementById('adminUserInfo').textContent = `${currentUser.username} (#${currentUser.id}) · ${roleLabel(currentUser.role)}`;
      await loadUsers();
    }

    // ── 侧边栏切换 ──────────────────────────────────────────
    document.querySelectorAll('.sidebar-item').forEach(item => {
      item.addEventListener('click', () => {
        document.querySelectorAll('.sidebar-item').forEach(i => i.classList.remove('active'));
        document.querySelectorAll('.admin-panel').forEach(p => p.classList.remove('active'));
        item.classList.add('active');
        const panel = document.getElementById('panel-' + item.dataset.panel);
        if (panel) panel.classList.add('active');
        if (item.dataset.panel === 'problems') loadProblems();
        if (item.dataset.panel === 'prompts') loadPrompts();
        if (item.dataset.panel === 'feedback') loadFeedbackAdmin();
        if (item.dataset.panel === 'activetime') loadActiveTime();
        if (item.dataset.panel === 'graph') { loadGraphInfo(); loadGraphEdges(); }
      });
    });

    // ── 用户管理 ────────────────────────────────────────────
    function roleLabel(role) {
      return { superadmin: '超级管理员', admin: '管理员', palacestudent: '少年宫用户', user: '普通用户' }[role] || role;
    }

    function roleBadgeClass(role) {
      return { superadmin: 'role-superadmin', admin: 'role-admin', palacestudent: 'role-palacestudent', user: 'role-user' }[role] || 'role-user';
    }

    async function loadUsers() {
      const res  = await fetch('/api/admin/users');
      const data = await res.json();
      if (!data.success) return;
      allUsers = data.users;
      renderUsers();
    }

    function renderUsers() {
      const tbody = document.getElementById('userTableBody');
      tbody.innerHTML = allUsers.map(u => `
        <tr class="${u.locked ? 'row-locked' : (u.disabled ? 'row-disabled' : '')}" data-id="${u.id}">
          <td><input type="checkbox" class="user-checkbox row-check" data-id="${u.id}"></td>
          <td><span class="account-id-mono">#${u.id}</span></td>
          <td>${u.username}</td>
          <td>${u.email || '—'}</td>
          <td>${u.displayName || '—'}</td>
          <td>${u.studentId || '—'}</td>
          <td><span class="role-badge ${roleBadgeClass(u.role)}">${roleLabel(u.role)}</span></td>
          <td style="font-size:11px;color:var(--text-muted)">${u.createdAt ? u.createdAt.slice(0, 10) : '—'}</td>
          <td style="font-size:12px;color:var(--text-secondary);text-align:right;padding-right:16px">${u.totalCalls || 0}</td>
          <td style="font-size:12px;color:var(--text-secondary);font-family:'JetBrains Mono',monospace">¥${(u.totalCost || 0).toFixed(4)}</td>
          <td>${u.disabled
            ? `<span class="disabled-badge">⛔ 已停用</span>`
            : (u.locked
              ? `<span class="locked-badge">🔒 已锁定</span>`
              : (u.loginFailCount > 0
                ? `<span style="font-size:11px;color:var(--text-muted)">失败 ${u.loginFailCount} 次</span>`
                : `<span style="font-size:11px;color:var(--text-muted)">正常</span>`))
          }</td>
          <td style="display:flex;gap:6px;flex-wrap:wrap">
            <button class="btn-sm primary" onclick="openEditUser('${u.id}')">编辑</button>
            ${u.locked ? `<button class="btn-sm unlock-btn" onclick="unlockUser('${u.id}')">解锁</button>` : ''}
            ${u.disabled
              ? `<button class="btn-sm enable-btn" onclick="enableUser('${u.id}')">复原</button>`
              : `<button class="btn-sm disable-btn" onclick="disableUser('${u.id}')">停用</button>`
            }
          </td>
        </tr>
      `).join('');

      // 绑定复选框事件
      document.querySelectorAll('.row-check').forEach(cb => {
        cb.addEventListener('change', updateExportCount);
      });
      updateExportCount();
    }

    function updateExportCount() {
      const checked = document.querySelectorAll('.row-check:checked');
      document.getElementById('exportCount').textContent = `已选 ${checked.length} 人`;
      document.getElementById('exportSelectedBtn').disabled = checked.length === 0;
    }

    // 全选
    document.getElementById('checkAll').addEventListener('change', function() {
      document.querySelectorAll('.row-check').forEach(cb => { cb.checked = this.checked; });
      updateExportCount();
    });

    function openEditUser(id) {
      const u = allUsers.find(u => u.id === id);
      if (!u) return;
      editingId = id;
      document.getElementById('editUserId').textContent = '#' + id;
      document.getElementById('editUsername').value     = u.username || '';
      document.getElementById('editEmail').value        = u.email || '';
      document.getElementById('editDisplayName').value  = u.displayName || '';
      document.getElementById('editStudentId').value    = u.studentId || '';
      document.getElementById('editRole').value         = u.role || 'user';
      document.getElementById('editNewPassword').value  = '';
      document.getElementById('editUserMsg').className  = 'modal-msg';

      // 只有超级管理员可以改角色
      document.getElementById('editRole').disabled = (currentUser.role !== 'superadmin');

      document.getElementById('editUserModal').classList.add('open');
    }

    document.getElementById('closeEditUser').addEventListener('click', () => {
      document.getElementById('editUserModal').classList.remove('open');
    });
    document.getElementById('cancelEditUser').addEventListener('click', () => {
      document.getElementById('editUserModal').classList.remove('open');
    });

    document.getElementById('saveEditUser').addEventListener('click', async () => {
      if (!editingId) return;
      const msg = document.getElementById('editUserMsg');
      msg.className = 'modal-msg';

      const username    = document.getElementById('editUsername').value.trim();
      const email       = document.getElementById('editEmail').value.trim();
      const displayName = document.getElementById('editDisplayName').value.trim();
      const studentId   = document.getElementById('editStudentId').value.trim();
      const role        = document.getElementById('editRole').value;
      const newPassword = document.getElementById('editNewPassword').value;

      // 修改基本信息
      const r1 = await fetch(`/api/admin/users/${editingId}`, {
        method: 'PATCH', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ username, email, displayName, studentId }),
      });
      const d1 = await r1.json();
      if (!d1.success) { msg.textContent = d1.error; msg.className = 'modal-msg show'; return; }

      // 改角色（如果是超级管理员）
      if (currentUser.role === 'superadmin') {
        const r2 = await fetch(`/api/admin/users/${editingId}/role`, {
          method: 'PATCH', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ role }),
        });
        const d2 = await r2.json();
        if (!d2.success) { msg.textContent = d2.error; msg.className = 'modal-msg show'; return; }
      }

      // 重置密码
      if (newPassword) {
        const r3 = await fetch(`/api/admin/users/${editingId}/reset-password`, {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ newPassword }),
        });
        const d3 = await r3.json();
        if (!d3.success) { msg.textContent = d3.error; msg.className = 'modal-msg show'; return; }
      }

      document.getElementById('editUserModal').classList.remove('open');
      showToast('保存成功');
      await loadUsers();
    });

    // ── 题库管理 ────────────────────────────────────────────
    async function loadProblems() {
      const res  = await fetch('/api/admin/problems');
      const data = await res.json();
      if (!data.success) return;
      const list = document.getElementById('problemList');
      const probs = Object.values(data.problems);
      list.innerHTML = probs.length === 0
        ? '<div style="padding:16px;font-size:13px;color:var(--text-muted)">暂无题目</div>'
        : probs.map(p => `
            <div class="problem-row">
              <span class="problem-id">${p.id}</span>
              <span class="problem-title">${p.title}</span>
              <span style="font-size:11px;color:var(--text-muted)">${p.timeLimit || 1000}ms / ${p.memoryLimit || 256}MB</span>
            </div>
          `).join('');
    }

    document.getElementById('newProbId').addEventListener('input', async () => {
      const id  = document.getElementById('newProbId').value.trim();
      const msg = document.getElementById('addProbMsg');
      if (!id) { msg.className = 'section-msg'; return; }
      const res  = await fetch('/api/admin/problems');
      const data = await res.json();
      if (data.success && data.problems[id]) {
        msg.textContent = `题号 ${id} 已存在，请换一个`;
        msg.className = 'section-msg error';
      } else {
        msg.className = 'section-msg';
      }
    });

    document.getElementById('addProbBtn').addEventListener('click', async () => {
      const id     = document.getElementById('newProbId').value.trim();
      const title  = document.getElementById('newProbTitle').value.trim();
      const msg    = document.getElementById('addProbMsg');
      msg.className = 'section-msg';
      if (!id || !title) { msg.textContent = '题目编号和标题必填'; msg.className = 'section-msg error'; return; }

      // 二次检查题号重复
      const checkRes  = await fetch('/api/admin/problems');
      const checkData = await checkRes.json();
      if (checkData.success && checkData.problems[id]) {
        msg.textContent = `题号 ${id} 已存在，请换一个`;
        msg.className = 'section-msg error';
        return;
      }

      const res  = await fetch('/api/admin/problems', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          id, title,
          description:  document.getElementById('newProbDesc').value,
          inputDesc:    document.getElementById('newProbInput').value,
          outputDesc:   document.getElementById('newProbOutput').value,
          timeLimit:    parseInt(document.getElementById('newProbTime').value) || 1000,
          memoryLimit:  parseInt(document.getElementById('newProbMem').value)  || 256,
          samples: [],
        }),
      });
      const data = await res.json();
      if (data.success) {
        msg.textContent = `题目 ${id} 添加成功`;
        msg.className = 'section-msg success';
        loadProblems();
      } else {
        msg.textContent = data.error || '添加失败';
        msg.className = 'section-msg error';
      }
    });

    // ── 提示词管理 ──────────────────────────────────────────
    async function loadPrompts() {
      const res  = await fetch('/api/admin/prompts');
      const data = await res.json();
      if (!data.success) return;
      const wrap = document.getElementById('promptsWrap');
      wrap.innerHTML = Object.entries(data.prompts).map(([key, val]) => `
        <div class="prompt-card">
          <div class="prompt-card-header">${key}</div>
          <textarea data-key="${key}">${val}</textarea>
        </div>
      `).join('');
    }

    document.getElementById('savePromptsBtn').addEventListener('click', async () => {
      const msg = document.getElementById('promptsMsg');
      msg.className = 'section-msg';
      const newPrompts = {};
      document.querySelectorAll('#promptsWrap textarea').forEach(ta => {
        newPrompts[ta.dataset.key] = ta.value;
      });
      // 通过管理员接口更新 prompts（需要后端支持）
      const res = await fetch('/api/admin/prompts', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ prompts: newPrompts }),
      });
      const data = await res.json();
      if (data.success) {
        msg.textContent = '保存成功';
        msg.className = 'section-msg success';
      } else {
        msg.textContent = data.error || '保存失败';
        msg.className = 'section-msg error';
      }
    });

    // ── Toast ───────────────────────────────────────────────
    async function unlockUser(id) {
      if (!confirm(`确定要解锁账号 #${id} 吗？`)) return;
      const res  = await fetch(`/api/admin/users/${id}/unlock`, { method: 'POST' });
      const data = await res.json();
      if (data.success) {
        showToast('账号已解锁 ✓');
        await loadUsers();
      } else {
        showToast('解锁失败：' + (data.error || '请重试'));
      }
    }

    async function disableUser(id) {
      const u = allUsers.find(u => u.id === id);
      if (!confirm(`确定要停用账号 #${id}（${u?.username || ''}）？停用后该账号无法登录。`)) return;
      const res  = await fetch(`/api/admin/users/${id}/disable`, { method: 'POST' });
      const data = await res.json();
      if (data.success) { showToast('账号已停用'); await loadUsers(); }
      else showToast('停用失败：' + (data.error || '请重试'));
    }

    async function enableUser(id) {
      const u = allUsers.find(u => u.id === id);
      if (!confirm(`确定要复原账号 #${id}（${u?.username || ''}）？`)) return;
      const res  = await fetch(`/api/admin/users/${id}/enable`, { method: 'POST' });
      const data = await res.json();
      if (data.success) { showToast('账号已复原 ✓'); await loadUsers(); }
      else showToast('复原失败：' + (data.error || '请重试'));
    }

    // ── CSV 导出 ─────────────────────────────────────────────
    function escapeCSV(val) {
      const s = String(val == null ? '' : val);
      if (s.includes(',') || s.includes('"') || s.includes('\n')) {
        return '"' + s.replace(/"/g, '""') + '"';
      }
      return s;
    }

    async function exportConversations(userIds) {
      if (!userIds.length) return;
      showToast('正在导出，请稍候…');
      const allRows = [];
      for (const id of userIds) {
        const res  = await fetch(`/api/admin/users/${id}/conversations`);
        const data = await res.json();
        if (data.success) allRows.push(...data.rows);
      }
      if (!allRows.length) { showToast('所选用户暂无对话记录'); return; }

      const headers = ['用户ID', '用户名', '题目', '对话线程Key', '对话线程名称', '用户提问', 'AI回答'];
      const lines = [
        headers.join(','),
        ...allRows.map(r => [
          escapeCSV(r.userId),
          escapeCSV(r.username),
          escapeCSV(r.problemId),
          escapeCSV(r.sessionKey),
          escapeCSV(r.sessionName),
          escapeCSV(r.userMessage),
          escapeCSV(r.aiReply),
        ].join(',')),
      ];

      const csv  = '\uFEFF' + lines.join('\r\n');
      const blob = new Blob([csv], { type: 'text/csv;charset=utf-8' });
      const url  = URL.createObjectURL(blob);
      const a    = document.createElement('a');
      a.href     = url;
      a.download = `conversations_${new Date().toISOString().slice(0,10)}.csv`;
      a.click();
      URL.revokeObjectURL(url);
      showToast(`已导出 ${allRows.length} 条对话记录 ✓`);
    }

    document.getElementById('exportSelectedBtn').addEventListener('click', () => {
      const ids = [...document.querySelectorAll('.row-check:checked')].map(cb => cb.dataset.id);
      exportConversations(ids);
    });

    document.getElementById('exportAllBtn').addEventListener('click', () => {
      const ids = allUsers.map(u => u.id);
      exportConversations(ids);
    });

    function showToast(msg) {
      const el = document.getElementById('toast');
      el.textContent = msg;
      el.classList.add('show');
      setTimeout(() => el.classList.remove('show'), 2500);
    }

    // ── 反馈管理 ────────────────────────────────────────────
    let allFeedbacks = [];

    async function loadFeedbackAdmin() {
      const res  = await fetch('/api/admin/feedback');
      const data = await res.json();
      if (!data.success) return;
      allFeedbacks = data.feedbacks;
      renderFeedbackTable();
    }

    function renderFeedbackTable() {
      const tbody = document.getElementById('feedbackTableBody');
      if (!allFeedbacks.length) {
        tbody.innerHTML = '<tr><td colspan="5" style="padding:16px;color:var(--text-muted);font-size:13px">暂无反馈</td></tr>';
        return;
      }
      tbody.innerHTML = allFeedbacks.map(f => {
        const statusLabel = f.status === 'accepted' ? `<span style="color:#22c55e;font-size:12px;font-weight:600">已采纳 (${f.score}分)</span>`
          : f.status === 'rejected' ? `<span style="color:var(--text-muted);font-size:12px">未采纳</span>`
          : `<span style="color:#f59e0b;font-size:12px">待审核</span>`;
        return `<tr data-id="${f.id}">
          <td style="white-space:nowrap">${f.username}</td>
          <td style="font-size:12px;max-width:320px;word-break:break-all">${escapeHTML(f.content)}</td>
          <td style="font-size:11px;color:var(--text-muted);white-space:nowrap">${f.createdAt?.slice(0, 10) || ''}</td>
          <td>${statusLabel}</td>
          <td style="white-space:nowrap">
            <select class="fb-score-select" data-id="${f.id}" style="padding:3px 6px;font-size:12px;border:1px solid var(--border);border-radius:4px;background:var(--surface)">
              <option value="">选择分数</option>
              <option value="0"${f.score === 0 ? ' selected' : ''}>0 (不采纳)</option>
              <option value="1"${f.score === 1 ? ' selected' : ''}>1</option>
              <option value="2"${f.score === 2 ? ' selected' : ''}>2</option>
              <option value="3"${f.score === 3 ? ' selected' : ''}>3</option>
              <option value="4"${f.score === 4 ? ' selected' : ''}>4</option>
              <option value="5"${f.score === 5 ? ' selected' : ''}>5</option>
            </select>
            <button class="btn-sm primary fb-save-btn" data-id="${f.id}" style="margin-left:4px">确认</button>
          </td>
        </tr>`;
      }).join('');

      document.querySelectorAll('.fb-save-btn').forEach(btn => {
        btn.addEventListener('click', async () => {
          const id = btn.dataset.id;
          const select = document.querySelector(`.fb-score-select[data-id="${id}"]`);
          const score = select.value;
          if (score === '') { showToast('请选择分数'); return; }
          const res = await fetch(`/api/admin/feedback/${id}`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ score: Number(score) }),
          });
          const data = await res.json();
          if (data.success) { showToast('审核成功'); loadFeedbackAdmin(); }
          else showToast(data.error || '操作失败');
        });
      });
    }

    function escapeHTML(s) {
      const d = document.createElement('div');
      d.textContent = s;
      return d.innerHTML;
    }

    // ── 活跃时长 ────────────────────────────────────────────
    let activeTimeData = [];

    async function loadActiveTime() {
      const res  = await fetch('/api/admin/active-time/summary');
      const data = await res.json();
      if (!data.success) return;
      activeTimeData = data.rows;
      renderActiveTimeTable();
    }

    function renderActiveTimeTable() {
      const tbody = document.getElementById('activeTimeTableBody');
      if (!activeTimeData.length) {
        tbody.innerHTML = '<tr><td colspan="6" style="padding:16px;color:var(--text-muted);font-size:13px">暂无数据</td></tr>';
        return;
      }
      const sorted = [...activeTimeData].sort((a, b) => b.totalMinutes - a.totalMinutes);
      tbody.innerHTML = sorted.map(r => `
        <tr>
          <td><span class="account-id-mono">#${r.userId}</span></td>
          <td>${escapeHTML(r.username)}</td>
          <td>${escapeHTML(r.displayName || '—')}</td>
          <td style="text-align:right;padding-right:16px">${r.activeDays}</td>
          <td style="text-align:right;padding-right:16px;font-family:'JetBrains Mono',monospace">${r.totalMinutes}</td>
          <td style="text-align:right;padding-right:16px;font-family:'JetBrains Mono',monospace">${r.avgMinutesPerActiveDay}</td>
        </tr>
      `).join('');
    }

    document.getElementById('exportActiveTimeBtn').addEventListener('click', () => {
      if (!activeTimeData.length) { showToast('暂无数据'); return; }
      const allDates = new Set();
      for (const r of activeTimeData) {
        for (const d of Object.keys(r.dailyMinutes || {})) allDates.add(d);
      }
      const dates = [...allDates].sort();

      const headers = ['用户ID', '用户名', '姓名', ...dates, '总时长(分钟)', '活跃天数', '活跃日均(分钟)'];
      const lines = [headers.map(h => escapeCSV(h)).join(',')];

      const sorted = [...activeTimeData].sort((a, b) => b.totalMinutes - a.totalMinutes);
      for (const r of sorted) {
        const cols = [
          escapeCSV(r.userId),
          escapeCSV(r.username),
          escapeCSV(r.displayName || ''),
          ...dates.map(d => escapeCSV(Math.round((r.dailyMinutes || {})[d] || 0))),
          escapeCSV(r.totalMinutes),
          escapeCSV(r.activeDays),
          escapeCSV(r.avgMinutesPerActiveDay),
        ];
        lines.push(cols.join(','));
      }

      const csv  = '\uFEFF' + lines.join('\r\n');
      const blob = new Blob([csv], { type: 'text/csv;charset=utf-8' });
      const url  = URL.createObjectURL(blob);
      const a    = document.createElement('a');
      a.href     = url;
      a.download = `active_time_${new Date().toISOString().slice(0,10)}.csv`;
      a.click();
      URL.revokeObjectURL(url);
      showToast(`已导出 ${sorted.length} 条用户活跃时长数据 ✓`);
    });

    // ── 问题图谱管理 ──────────────────────────────────
    let graphEdgesData = [];

    async function loadGraphInfo() {
      try {
        const res = await fetch('/api/graph/info');
        const data = await res.json();
        const info = document.getElementById('graphInfo');
        if (data.nodes !== undefined) {
          const types = data.edge_types || {};
          const typesStr = Object.entries(types).map(([t, c]) => `${t}: ${c}`).join('，');
          info.textContent = `节点：${data.nodes}，边：${data.edges}（${typesStr || '无'}）`;
        } else {
          info.textContent = '推荐服务不可用，请启动 recommend_server.py';
          info.style.color = '#ef4444';
        }
      } catch {
        document.getElementById('graphInfo').textContent = '推荐服务不可用';
      }
    }

    async function loadGraphEdges() {
      try {
        const res = await fetch('/api/admin/graph/edges');
        const data = await res.json();
        graphEdgesData = data.edges || [];
        renderGraphEdges();
      } catch {
        document.getElementById('graphEdgesTableBody').innerHTML = '<tr><td colspan="7" style="text-align:center;color:var(--text-muted)">推荐服务不可用</td></tr>';
      }
    }

    function renderGraphEdges() {
      const tbody = document.getElementById('graphEdgesTableBody');
      if (!graphEdgesData.length) {
        tbody.innerHTML = '<tr><td colspan="7" style="text-align:center;color:var(--text-muted)">暂无数据</td></tr>';
        return;
      }
      const sorted = [...graphEdgesData].sort((a, b) => (b.confidence || 0) - (a.confidence || 0));
      const seen = new Set();
      const deduped = [];
      for (const e of sorted) {
        const key = [e.id_a, e.id_b].sort().join('-') + '-' + e.relation;
        if (seen.has(key)) continue;
        seen.add(key);
        deduped.push(e);
      }
      tbody.innerHTML = deduped.slice(0, 200).map(e => `
        <tr>
          <td><span class="account-id-mono">#${escapeHTML(e.id_a)}</span></td>
          <td><span class="account-id-mono">#${escapeHTML(e.id_b)}</span></td>
          <td>${escapeHTML(e.relation)}</td>
          <td>${(e.confidence || 0).toFixed(2)}</td>
          <td><span class="role-badge ${e.source === 'teacher' ? 'role-admin' : 'role-user'}">${escapeHTML(e.source || 'auto')}</span></td>
          <td style="max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="${escapeHTML(e.reason || '')}">${escapeHTML(e.reason || '')}</td>
          <td><button class="btn-sm danger graph-del-edge" data-a="${e.id_a}" data-b="${e.id_b}">删除</button></td>
        </tr>
      `).join('');
      tbody.querySelectorAll('.graph-del-edge').forEach(btn => {
        btn.addEventListener('click', async () => {
          if (!confirm(`确定删除 #${btn.dataset.a} ↔ #${btn.dataset.b} 的关系？`)) return;
          try {
            const res = await fetch('/api/admin/graph/edit', {
              method: 'POST', headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ action: 'remove_edge', id_a: btn.dataset.a, id_b: btn.dataset.b }),
            });
            const data = await res.json();
            if (data.success) { showToast('已删除'); loadGraphEdges(); loadGraphInfo(); }
            else showToast(data.error || '删除失败');
          } catch { showToast('请求失败'); }
        });
      });
    }

    document.getElementById('graphDiffSubmit').addEventListener('click', async () => {
      const id = document.getElementById('graphDiffId').value.trim();
      const difficulty = parseInt(document.getElementById('graphDiffValue').value);
      const reason = document.getElementById('graphDiffReason').value.trim();
      const msg = document.getElementById('graphDiffMsg');
      if (!id || isNaN(difficulty)) { msg.textContent = '请填写题号和难度'; msg.style.color = '#ef4444'; return; }
      try {
        const res = await fetch('/api/admin/graph/edit', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'update_difficulty', id, difficulty, reason }),
        });
        const data = await res.json();
        if (data.success) { msg.textContent = '已修改 ✓'; msg.style.color = '#22c55e'; loadGraphInfo(); }
        else { msg.textContent = data.error || '修改失败'; msg.style.color = '#ef4444'; }
      } catch { msg.textContent = '请求失败'; msg.style.color = '#ef4444'; }
    });

    document.getElementById('graphEdgeSubmit').addEventListener('click', async () => {
      const id_a = document.getElementById('graphEdgeA').value.trim();
      const id_b = document.getElementById('graphEdgeB').value.trim();
      const relation = document.getElementById('graphEdgeType').value;
      const reason = document.getElementById('graphEdgeReason').value.trim() || '教师标注';
      const msg = document.getElementById('graphEdgeMsg');
      if (!id_a || !id_b) { msg.textContent = '请填写两个题号'; msg.style.color = '#ef4444'; return; }
      try {
        const res = await fetch('/api/admin/graph/edit', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'add_edge', id_a, id_b, relation, reason }),
        });
        const data = await res.json();
        if (data.success) { msg.textContent = '已添加 ✓'; msg.style.color = '#22c55e'; loadGraphEdges(); loadGraphInfo(); }
        else { msg.textContent = data.error || '添加失败'; msg.style.color = '#ef4444'; }
      } catch { msg.textContent = '请求失败'; msg.style.color = '#ef4444'; }
    });

    document.getElementById('graphRefreshEdges').addEventListener('click', () => { loadGraphEdges(); loadGraphInfo(); });

    init();
  </script>
</body>
</html>
