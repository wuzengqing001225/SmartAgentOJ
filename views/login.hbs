<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>登录 — SNG SmartOJ</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Noto+Sans+SC:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    /* 将 style.css 中的实际变量映射到 login 页使用的别名 */
    :root {
      --accent:    hsl(25, 76%, 52%);
      --surface:   hsl(220, 14%, 99%);
      --surface-2: hsl(220, 14%, 95%);
    }
    body { display: flex; align-items: center; justify-content: center; min-height: 100vh; background: var(--bg-dark); }
    .auth-wrap { width: 100%; max-width: 420px; padding: 24px; }
    .auth-logo { text-align: center; margin-bottom: 32px; }
    .auth-logo .logo { font-size: 24px; font-weight: 700; letter-spacing: -0.5px; color: var(--text); font-family: 'JetBrains Mono', monospace; }
    .auth-logo .logo-accent { color: var(--accent); }
    .auth-logo .auth-subtitle { font-size: 13px; color: var(--text-secondary); margin-top: 4px; }
    .auth-card { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; overflow: hidden; }
    .auth-tabs { display: flex; border-bottom: 1px solid var(--border); }
    .auth-tab { flex: 1; padding: 14px; font-size: 13px; font-weight: 500; text-align: center; cursor: pointer; color: var(--text-secondary); background: transparent; border: none; transition: all 0.15s; font-family: var(--font-body); }
    .auth-tab.active { color: var(--accent); background: var(--surface-2); }
    .auth-form { padding: 24px; display: none; }
    .auth-form.active { display: block; }
    .form-group { margin-bottom: 16px; }
    .form-label { font-size: 12px; color: var(--text-secondary); margin-bottom: 6px; display: block; font-weight: 500; }
    .form-input { width: 100%; padding: 9px 12px; background: var(--bg); border: 1px solid var(--border); border-radius: 6px; font-size: 13px; color: var(--text); font-family: inherit; transition: border-color 0.15s; box-sizing: border-box; }
    .form-input::placeholder { color: var(--text-muted); }
    .form-input:focus { outline: none; border-color: var(--accent); }
    .form-hint { font-size: 11px; color: var(--text-secondary); margin-top: 4px; }
    .form-divider { font-size: 11px; color: var(--text-secondary); margin: 4px 0 12px; }
    .btn-auth { width: 100%; padding: 10px; background: var(--accent); color: #fff; border: none; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer; margin-top: 8px; transition: opacity 0.15s; font-family: var(--font-body); }
    .btn-auth:hover { opacity: 0.88; }
    .btn-auth:disabled { opacity: 0.5; cursor: not-allowed; }
    .auth-msg { font-size: 12px; margin-top: 12px; padding: 8px 12px; border-radius: 6px; display: none; }
    .auth-msg.error { background: rgba(239,68,68,0.1); color: #ef4444; display: block; }
    .auth-msg.success { background: rgba(34,197,94,0.1); color: #22c55e; display: block; }
    .register-success { text-align: center; padding: 8px 0; }
    .register-success .account-id { font-family: 'JetBrains Mono', monospace; font-size: 28px; font-weight: 700; color: var(--accent); letter-spacing: 2px; margin: 12px 0; }
    .register-success p { font-size: 13px; color: var(--text-secondary); }
  </style>
</head>
<body>
  <div class="auth-wrap">
    <div class="auth-logo">
      <div class="logo">SNG<span class="logo-accent">SmartOJ</span></div>
      <div class="auth-subtitle">中福会少年宫计算机中心智能AI编程训练平台</div>
    </div>

    <div class="auth-card">
      <div class="auth-tabs">
        <button class="auth-tab active" data-tab="login">登录</button>
        <button class="auth-tab" data-tab="register">注册</button>
      </div>

      <!-- 登录表单 -->
      <div class="auth-form active" id="loginForm">
        <div class="form-group">
          <label class="form-label">账号编号 / 用户名</label>
          <input type="text" id="loginUsername" class="form-input" placeholder="例：用户名 或 账号编号 3ea6df" autocomplete="username">
        </div>
        <div class="form-group">
          <label class="form-label">密码</label>
          <input type="password" id="loginPassword" class="form-input" placeholder="输入密码" autocomplete="current-password">
        </div>
        <div class="auth-msg" id="loginMsg"></div>
        <button class="btn-auth" id="loginBtn">登录</button>
      </div>

      <!-- 注册表单 -->
      <div class="auth-form" id="registerForm">
        <div class="form-divider">必填信息</div>
        <div class="form-group">
          <label class="form-label">邮箱</label>
          <input type="email" id="regEmail" class="form-input" placeholder="your@email.com" autocomplete="email">
        </div>
        <div class="form-group">
          <label class="form-label">用户名</label>
          <input type="text" id="regUsername" class="form-input" placeholder="任意用户名" autocomplete="username">
        </div>
        <div class="form-group">
          <label class="form-label">密码</label>
          <input type="password" id="regPassword" class="form-input" placeholder="至少6位" autocomplete="new-password">
        </div>
        <div class="form-divider">选填信息</div>
        <div class="form-group">
          <label class="form-label">姓名（选填）</label>
          <input type="text" id="regName" class="form-input" placeholder="真实姓名">
        </div>
        <div class="form-group">
          <label class="form-label">少年宫学生证编号（选填）</label>
          <input type="text" id="regStudentId" class="form-input" placeholder="123456789012" maxlength="12">
        </div>
        <div class="auth-msg" id="registerMsg"></div>
        <div id="registerSuccess" style="display:none" class="register-success">
          <p>注册成功！你的账号编号是</p>
          <div class="account-id" id="newAccountId">——</div>
          <p>请牢记此编号，可用它或用户名登录</p>
          <button class="btn-auth" id="goLoginBtn" style="margin-top:16px">去登录</button>
        </div>
        <button class="btn-auth" id="registerBtn">注册账号</button>
      </div>
    </div>
  </div>

  <script>
    // Tab 切换
    document.querySelectorAll('.auth-tab').forEach(tab => {
      tab.addEventListener('click', () => {
        document.querySelectorAll('.auth-tab').forEach(t => t.classList.remove('active'));
        document.querySelectorAll('.auth-form').forEach(f => f.classList.remove('active'));
        tab.classList.add('active');
        document.getElementById(tab.dataset.tab + 'Form').classList.add('active');
      });
    });

    function showMsg(el, msg, type) {
      el.textContent = msg;
      el.className = 'auth-msg ' + type;
    }

    // 登录
    document.getElementById('loginBtn').addEventListener('click', async () => {
      const username = document.getElementById('loginUsername').value.trim();
      const password = document.getElementById('loginPassword').value;
      const msg      = document.getElementById('loginMsg');
      const btn      = document.getElementById('loginBtn');
      if (!username || !password) return showMsg(msg, '请填写账号和密码', 'error');
      btn.disabled = true;
      btn.textContent = '登录中…';
      try {
        const res  = await fetch('/api/auth/login', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ username, password }),
        });
        const data = await res.json();
        if (data.success) {
          window.location.href = '/';
        } else {
          showMsg(msg, data.error || '登录失败', 'error');
        }
      } catch {
        showMsg(msg, '网络错误，请重试', 'error');
      } finally {
        btn.disabled = false;
        btn.textContent = '登录';
      }
    });

    // 回车触发登录
    ['loginUsername', 'loginPassword'].forEach(id => {
      document.getElementById(id).addEventListener('keydown', e => {
        if (e.key === 'Enter') document.getElementById('loginBtn').click();
      });
    });

    // 注册
    document.getElementById('registerBtn').addEventListener('click', async () => {
      const email     = document.getElementById('regEmail').value.trim();
      const username  = document.getElementById('regUsername').value.trim();
      const password  = document.getElementById('regPassword').value;
      const displayName = document.getElementById('regName').value.trim();
      const studentId = document.getElementById('regStudentId').value.trim();
      const msg       = document.getElementById('registerMsg');
      const btn       = document.getElementById('registerBtn');
      if (!email || !username || !password) return showMsg(msg, '请填写邮箱、用户名和密码', 'error');
      btn.disabled = true;
      btn.textContent = '注册中…';
      try {
        const res  = await fetch('/api/auth/register', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, username, password, displayName, studentId }),
        });
        const data = await res.json();
        if (data.success) {
          msg.className = 'auth-msg';
          document.getElementById('newAccountId').textContent = '#' + data.accountId;
          document.getElementById('registerSuccess').style.display = 'block';
          btn.style.display = 'none';
        } else {
          showMsg(msg, data.error || '注册失败', 'error');
        }
      } catch {
        showMsg(msg, '网络错误，请重试', 'error');
      } finally {
        btn.disabled = false;
        btn.textContent = '注册账号';
      }
    });

    document.getElementById('goLoginBtn').addEventListener('click', () => {
      document.querySelector('[data-tab="login"]').click();
      document.getElementById('registerSuccess').style.display = 'none';
      document.getElementById('registerBtn').style.display = 'block';
    });
  </script>
</body>
</html>
